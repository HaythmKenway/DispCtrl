<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Linux client's checks. Needs no monitors and no X server: the X
       display is pointed somewhere that cannot answer, so nothing here can
       change a ramp, and CI runs it on every push. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/DispCtrl.Linux.Core/DispCtrl.Linux.Core.csproj" />
    <!-- Built alongside, so the engine can be started as a real process. -->
    <ProjectReference Include="../../src/DispCtrl.Linux/DispCtrl.Linux.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The window process's single-instance hand-off, compiled in rather than
         referenced: the GUI project drags Avalonia in, and this needs none. -->
    <Compile Include="../../src/DispCtrl.Linux.Gui/Services/Instance.cs" Link="Gui/Instance.cs" />
    <Compile Include="../../src/DispCtrl.Linux.Gui/Services/Log.cs" Link="Gui/Log.cs" />
  </ItemGroup>
</Project>
