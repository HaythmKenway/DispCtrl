<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:styling="using:FluentAvalonia.Styling"
             x:Class="DispCtrl.Linux.Gui.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <!-- FluentAvaloniaTheme in place of Avalonia's own FluentTheme: it is
             what actually gives WinUI-style controls (SettingsExpanderItem,
             NavigationView, the Segoe-Fluent icon set) their real look, rather
             than dispctrl-linux-gui rendering as a plain default Avalonia app.
             PreferSystemTheme/PreferUserAccentColor follow the desktop's own
             dark/light mode and accent colour, the same as the Windows app
             following the shell rather than hard-coding a palette. -->
        <!-- PreferSystemTheme and PreferUserAccentColor are set in App.Initialize,
             only where gsettings exists: FluentAvalonia starts it unguarded, and
             without it (KDE or XFCE without GLib's tools, Alpine, Void) the
             window crashed before it opened. -->
        <styling:FluentAvaloniaTheme />
        <StyleInclude Source="avares://dispctrl-linux-gui/Styles/Cards.axaml" />
    </Application.Styles>
</Application>