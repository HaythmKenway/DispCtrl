<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:DispCtrl.Linux.Gui.ViewModels"
             xmlns:controls="using:DispCtrl.Linux.Gui.Views.Controls"
             x:Class="DispCtrl.Linux.Gui.Views.Pages.DisplaysPage">

    <UserControl.Styles>
        <!-- The expander's own header and content, drawn as one card. -->
        <Style Selector="Expander.display">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <DataTemplate x:Key="BrightnessRow" DataType="vm:MonitorRowViewModel">
            <Border Classes="subcard">
                <Grid Classes="cardgrid bare" ColumnDefinitions="0,*,Auto" RowDefinitions="Auto,Auto">
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Classes="title" Text="Brightness" />
                        <TextBlock Classes="caption" Text="{Binding Subtitle}" />
                        <TextBlock Classes="status" Text="{Binding Status}" IsVisible="{Binding HasStatus}" />
                    </StackPanel>
                    <Grid Classes="slider control" ColumnDefinitions="*,56">
                        <Slider Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                Value="{Binding Value, Mode=TwoWay}" VerticalAlignment="Center"
                                AutomationProperties.Name="Brightness" />
                        <TextBlock Text="{Binding ValueText}" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="DimRow" DataType="vm:MonitorRowViewModel">
            <Border Classes="subcard">
                <Grid Classes="cardgrid bare" ColumnDefinitions="0,*,Auto" RowDefinitions="Auto,Auto">
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Classes="title" Text="Dim in software" />
                        <TextBlock Classes="caption" Text="Below what the panel itself can do, through the gamma ramp." />
                        <TextBlock Classes="status" Text="{Binding Status}" IsVisible="{Binding HasStatus}" />
                    </StackPanel>
                    <Grid Classes="slider control" ColumnDefinitions="*,56">
                        <Slider Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                Value="{Binding Value, Mode=TwoWay}" VerticalAlignment="Center"
                                AutomationProperties.Name="Dim in software" />
                        <TextBlock Text="{Binding ValueText}" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Panel Name="Root">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Name="Body" Classes="page">

                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock Classes="pagetitle" Text="Displays" />
                        <TextBlock Name="Topology" Classes="pagesubtitle" />
                    </StackPanel>
                    <Button Grid.Column="1" Name="RescanButton" Click="OnRescan" VerticalAlignment="Bottom"
                            Width="40" Height="36" Padding="0" Margin="12,0,0,0"
                            ToolTip.Tip="Look for displays again: a few seconds of DDC/CI traffic per monitor"
                            AutomationProperties.Name="Rescan displays">
                        <ui:FASymbolIcon Symbol="Refresh" FontSize="16" />
                    </Button>
                </Grid>

                <ProgressBar Name="ScanBar" IsIndeterminate="True" IsVisible="False" Margin="0,12,0,0"
                             AutomationProperties.Name="Looking for displays" />

                <Border Name="WaylandNotice" Classes="notice info" Margin="0,20,0,0" IsVisible="False">
                    <TextBlock TextWrapping="Wrap"
                               Text="A Wayland session arranges its displays itself, and only its own settings may move them. Brightness still works: see the Brightness page." />
                </Border>

                <Border Name="NoXrandrNotice" Classes="notice info" Margin="0,20,0,0" IsVisible="False">
                    <TextBlock TextWrapping="Wrap"
                               Text="No X server with RandR answers, so displays cannot be arranged or their modes changed from here. Brightness and night light do not need it." />
                </Border>

                <!-- The arrangement leads the page, as on Windows: it is the picture
                     of the desk, and everything below belongs to one of its panels. -->
                <StackPanel Name="ArrangeSection" Spacing="8" Margin="0,24,0,0">
                    <Grid ColumnDefinitions="40,*">
                        <ui:FASymbolIcon Classes="cardicon" Symbol="ViewAll" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Classes="title" Text="Arrange displays" />
                            <TextBlock Classes="caption"
                                       Text="Drag a display to match where it sits on your desk, or choose one and use the arrow keys. Nothing changes until you apply, and you can go back for fifteen seconds after." />
                        </StackPanel>
                    </Grid>
                    <controls:ArrangeCanvas Name="ArrangeSurface" />
                    <TextBlock Classes="caption" Margin="2,0,0,0"
                               Text="GNOME and KDE keep a saved layout of their own, and may put it back at the next login or when a display is plugged in." />
                </StackPanel>

                <StackPanel Name="ProjectSection" Margin="0,24,0,0" Spacing="8">
                    <Grid ColumnDefinitions="40,*">
                        <ui:FASymbolIcon Classes="cardicon" Symbol="ShareScreen" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Classes="title" Text="Display mode" />
                            <TextBlock Classes="caption" Text="Windows' Win+P choices. Undone after 15 seconds unless you keep it." />
                        </StackPanel>
                    </Grid>
                    <WrapPanel Name="ProjectButtons" Orientation="Horizontal">
                        <Button Content="Extend" Tag="extend" Click="OnProject" Margin="0,0,8,8" AutomationProperties.Name="Extend" />
                        <Button Content="Duplicate" Tag="duplicate" Click="OnProject" Margin="0,0,8,8" AutomationProperties.Name="Duplicate" />
                        <Button Name="InternalButton" Content="Built-in display only" Tag="internal" Click="OnProject" Margin="0,0,8,8"
                                AutomationProperties.Name="Built-in display only" />
                        <Button Name="ExternalButton" Content="Other displays only" Tag="external" Click="OnProject" Margin="0,0,8,8"
                                AutomationProperties.Name="Other displays only" />
                    </WrapPanel>
                    <TextBlock Name="ProjectStatus" Classes="status" IsVisible="False" />
                </StackPanel>

                <TextBlock Classes="section" Text="Each display" />
                <ItemsControl Name="Outputs">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:OutputViewModel">
                            <Expander Classes="display" AutomationProperties.Name="{Binding Label}">
                                <Expander.Header>
                                    <Grid ColumnDefinitions="40,*" Margin="0,10">
                                        <PathIcon Classes="cardicon" Data="{StaticResource MonitorGlyph}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Classes="title" Text="{Binding Title}" />
                                            <TextBlock Classes="caption" Text="{Binding Details}" />
                                        </StackPanel>
                                    </Grid>
                                </Expander.Header>

                                <StackPanel>
                                    <Border Classes="subcard">
                                        <Grid Classes="cardgrid bare" ColumnDefinitions="0,*,Auto" RowDefinitions="Auto,Auto">
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Classes="title" Text="Main display" />
                                                <TextBlock Classes="caption"
                                                           Text="Where new windows open, and where most desktops put their panel and notifications." />
                                            </StackPanel>
                                            <Panel Classes="control">
                                                <Button Content="Make this my main display" Click="OnMakeMain"
                                                        Tag="{Binding Output.Name}" IsVisible="{Binding IsSecondary}"
                                                        AutomationProperties.Name="Make this my main display" />
                                                <TextBlock Classes="value" Text="This is your main display"
                                                           VerticalAlignment="Center" IsVisible="{Binding IsPrimary}" />
                                            </Panel>
                                        </Grid>
                                    </Border>

                                    <!-- The row is the content, not a binding path through it: a display without
                                         a brightness or dimming control has a null row, and a path through
                                         null logged a binding error per slider on every refresh. -->
                                    <ContentControl Content="{Binding Brightness}" ContentTemplate="{StaticResource BrightnessRow}"
                                                    HorizontalContentAlignment="Stretch" />
                                    <ContentControl Content="{Binding Dim}" ContentTemplate="{StaticResource DimRow}"
                                                    HorizontalContentAlignment="Stretch" />

                                    <Border Classes="subcard">
                                        <Grid Classes="cardgrid bare" ColumnDefinitions="0,*,Auto" RowDefinitions="Auto,Auto">
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Classes="title" Text="Resolution" />
                                                <TextBlock Classes="caption" Text="A change is undone after 15 seconds unless you keep it." />
                                            </StackPanel>
                                            <ComboBox Classes="control" ItemsSource="{Binding Resolutions}"
                                                      SelectedIndex="{Binding ResolutionIndex, Mode=TwoWay}" IsEnabled="{Binding HasModes}"
                                                      AutomationProperties.Name="Resolution" />
                                        </Grid>
                                    </Border>
                                    <Border Classes="subcard">
                                        <Grid Classes="cardgrid bare" ColumnDefinitions="0,*,Auto" RowDefinitions="Auto,Auto">
                                            <TextBlock Grid.Column="1" Classes="title" Text="Refresh rate" VerticalAlignment="Center" />
                                            <ComboBox Classes="control" ItemsSource="{Binding RefreshRates}"
                                                      SelectedIndex="{Binding RefreshIndex, Mode=TwoWay}" IsEnabled="{Binding HasModes}"
                                                      AutomationProperties.Name="Refresh rate" />
                                        </Grid>
                                    </Border>
                                    <Border Classes="subcard">
                                        <Grid Classes="cardgrid bare" ColumnDefinitions="0,*,Auto" RowDefinitions="Auto,Auto">
                                            <TextBlock Grid.Column="1" Classes="title" Text="Orientation" VerticalAlignment="Center" />
                                            <ComboBox Classes="control" ItemsSource="{x:Static vm:OutputViewModel.Orientations}"
                                                      SelectedIndex="{Binding OrientationIndex, Mode=TwoWay}"
                                                      AutomationProperties.Name="Orientation" />
                                        </Grid>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Controls}" IsVisible="{Binding HasControls}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:ControlRowViewModel">
                                                <Border Classes="subcard">
                                                    <Grid Classes="cardgrid bare" ColumnDefinitions="0,*,Auto" RowDefinitions="Auto,Auto">
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Classes="title" Text="{Binding Title}" />
                                                            <TextBlock Classes="status" Text="{Binding Status}" IsVisible="{Binding HasStatus}" />
                                                        </StackPanel>
                                                        <Panel Classes="control">
                                                            <ComboBox ItemsSource="{Binding Options}" IsVisible="{Binding IsList}"
                                                                      SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                                                                      AutomationProperties.Name="{Binding Title}" />
                                                            <Grid Classes="slider" ColumnDefinitions="*,56" IsVisible="{Binding IsLevel}">
                                                                <Slider Minimum="0" Maximum="{Binding Maximum}" Value="{Binding Value, Mode=TwoWay}"
                                                                        VerticalAlignment="Center" AutomationProperties.Name="{Binding Title}" />
                                                                <TextBlock Text="{Binding ValueText}" />
                                                            </Grid>
                                                        </Panel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Classes="subcard">
                                        <Grid Classes="cardgrid bare" ColumnDefinitions="0,*,Auto" RowDefinitions="Auto,Auto">
                                            <TextBlock Grid.Column="1" Classes="title" Text="Size" VerticalAlignment="Center" />
                                            <TextBlock Classes="value control" Text="{Binding SizeText}" />
                                        </Grid>
                                    </Border>
                                    <Border Classes="subcard">
                                        <Grid Classes="cardgrid bare" ColumnDefinitions="0,*,Auto" RowDefinitions="Auto,Auto">
                                            <TextBlock Grid.Column="1" Classes="title" Text="Position on the desktop" VerticalAlignment="Center" />
                                            <TextBlock Classes="value control" Text="{Binding PositionText}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Name="MainStatus" Classes="status" IsVisible="False" Margin="2,8,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Panel>
</UserControl>
