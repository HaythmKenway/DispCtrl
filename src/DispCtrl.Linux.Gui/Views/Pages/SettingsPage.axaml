<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="DispCtrl.Linux.Gui.Views.Pages.SettingsPage">
    <UserControl.Styles>
        <Style Selector="Ellipse.running">
            <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
        </Style>
        <Style Selector="Ellipse.stopped">
            <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
        </Style>
    </UserControl.Styles>
    <Panel Name="Root">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Name="Body" Classes="page">
                <TextBlock Classes="pagetitle" Text="Settings" />
                <TextBlock Classes="pagesubtitle" Text="The engine that keeps your settings applied, and where they are kept." />

                <TextBlock Classes="section" Text="Engine" />
                <StackPanel Spacing="4">
                    <Border Classes="card">
                        <Grid Classes="cardgrid" ColumnDefinitions="40,*,Auto" RowDefinitions="Auto,Auto">
                            <ui:FASymbolIcon Classes="cardicon" Symbol="Setting" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Classes="title" Text="Background engine" />
                                <TextBlock Name="EngineCaption" Classes="caption" />
                                <SelectableTextBlock Name="EngineCommand" FontFamily="monospace" FontSize="12" Margin="0,6,0,0"
                                                     TextWrapping="Wrap" IsVisible="False" />
                            </StackPanel>
                            <StackPanel Classes="control" Orientation="Horizontal" Spacing="8">
                                <Ellipse Name="EngineDot" Width="8" Height="8" VerticalAlignment="Center" />
                                <TextBlock Name="EngineState" Classes="value" VerticalAlignment="Center" />
                                <Button Name="EngineButton" Click="OnEngineButton" Margin="8,0,0,0"
                                        AutomationProperties.Name="Start or stop the engine" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <TextBlock Classes="section" Text="Tray icon and quick panel" />
                <StackPanel Spacing="4">
                    <Border Classes="card">
                        <Grid Classes="cardgrid" ColumnDefinitions="40,*,Auto" RowDefinitions="Auto,Auto">
                            <ui:FASymbolIcon Classes="cardicon" Symbol="OpenPane" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Classes="title" Text="Show the tray icon" />
                                <TextBlock Classes="caption"
                                           Text="From sign-in, in the panel's tray, with a menu of the switches you use most. GNOME shows it with the AppIndicator extension, which Ubuntu has on." />
                            </StackPanel>
                            <ToggleSwitch Name="TraySwitch" Classes="toggle" OnContent="On" OffContent="Off"
                                          AutomationProperties.Name="Show the tray icon" />
                        </Grid>
                    </Border>
                    <Border Classes="card">
                        <Grid Classes="cardgrid" ColumnDefinitions="40,*,Auto" RowDefinitions="Auto,Auto">
                            <ui:FASymbolIcon Classes="cardicon" Symbol="AllApps" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Classes="title" Text="Clicking the icon opens" />
                                <TextBlock Classes="caption" Text="A right click always opens its menu." />
                            </StackPanel>
                            <ComboBox Name="TrayClick" Classes="control" AutomationProperties.Name="Clicking the icon opens">
                                <ComboBoxItem Content="The quick panel" />
                                <ComboBoxItem Content="The window" />
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>

                <TextBlock Classes="section" Text="About" />
                <StackPanel Spacing="4">
                    <Border Classes="card">
                        <Grid Classes="cardgrid" ColumnDefinitions="40,*,Auto" RowDefinitions="Auto,Auto">
                            <Image Source="avares://dispctrl-linux-gui/Assets/dispctrl.png" Width="24" Height="24"
                                   HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Name="VersionText" Classes="title" />
                                <TextBlock Classes="caption"
                                           Text="For X11 desktops; brightness and night light also on Wayland. The command line, dispctrl-linux, does everything this window does." />
                            </StackPanel>
                            <Button Classes="control" Content="Read the guide" Click="OnGuide"
                                    AutomationProperties.Name="Read the guide" />
                        </Grid>
                    </Border>
                    <Border Classes="card">
                        <Grid Classes="cardgrid" ColumnDefinitions="40,*,Auto" RowDefinitions="Auto,Auto">
                            <ui:FASymbolIcon Classes="cardicon" Symbol="Document" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Classes="title" Text="Settings file" />
                                <SelectableTextBlock Name="SettingsPath" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Panel>
</UserControl>
