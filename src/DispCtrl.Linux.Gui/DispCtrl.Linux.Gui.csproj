<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Linux window (Avalonia), in the WinUI app's frame and page names:
       the arrangement and each display, brightness, dimming and night light,
       snap layouts, and the engine. It sends dispctrl-linux commands, through
       the engine when one runs; see docs/LINUX.md. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <TargetPlatformMinVersion />
    <AssemblyName>dispctrl-linux-gui</AssemblyName>
    <RootNamespace>DispCtrl.Linux.Gui</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <Platforms>x64</Platforms>
    <!-- linux-x64 unless asked: package.sh also publishes linux-arm64 and
         linux-musl-x64 (Alpine) with -r. -->
    <PlatformTarget>x64</PlatformTarget>
    <PlatformTarget Condition="$(RuntimeIdentifier.EndsWith('-arm64'))">arm64</PlatformTarget>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAvaloniaUI" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DispCtrl.Linux.Core\DispCtrl.Linux.Core.csproj" />
  </ItemGroup>
</Project>
