<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Linux window (Avalonia), in the WinUI app's frame and page names,
       and the tray icon with its menu and quick panel. It sends dispctrl-linux
       commands, through the engine when one runs; see docs/LINUX.md. Its
       build settings are build/linux/Linux.Build.props. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>dispctrl-linux-gui</AssemblyName>
    <RootNamespace>DispCtrl.Linux.Gui</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAvaloniaUI" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DispCtrl.Linux.Core\DispCtrl.Linux.Core.csproj" />
  </ItemGroup>
</Project>
