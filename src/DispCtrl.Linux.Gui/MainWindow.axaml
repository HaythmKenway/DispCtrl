<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="760"
        Width="1040" Height="760" MinWidth="380" MinHeight="420"
        x:Class="DispCtrl.Linux.Gui.MainWindow"
        Title="DispCtrl"
        Icon="avares://dispctrl-linux-gui/Assets/dispctrl.png"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">

    <!-- The Windows app's frame: a navigation pane with the same page names,
         open with labels when there is room and icons only when there is not.
         Only the pages Linux has: each claims only what it can do here. -->
    <ui:FANavigationView Name="Nav"
                         PaneDisplayMode="Auto"
                         CompactModeThresholdWidth="0"
                         ExpandedModeThresholdWidth="900"
                         OpenPaneLength="220"
                         IsBackButtonVisible="False"
                         IsSettingsVisible="False"
                         IsPaneToggleButtonVisible="True"
                         PaneTitle="DispCtrl">
        <ui:FANavigationView.MenuItems>
            <ui:FANavigationViewItem Content="Displays" Tag="displays" AutomationProperties.Name="Displays">
                <ui:FANavigationViewItem.IconSource>
                    <ui:FAPathIconSource Data="{StaticResource MonitorGlyph}" />
                </ui:FANavigationViewItem.IconSource>
            </ui:FANavigationViewItem>
            <ui:FANavigationViewItem Content="Brightness" Tag="brightness" AutomationProperties.Name="Brightness">
                <ui:FANavigationViewItem.IconSource>
                    <ui:FASymbolIconSource Symbol="WeatherSunny" />
                </ui:FANavigationViewItem.IconSource>
            </ui:FANavigationViewItem>
            <ui:FANavigationViewItem Content="Windows" Tag="windows" AutomationProperties.Name="Windows">
                <ui:FANavigationViewItem.IconSource>
                    <ui:FASymbolIconSource Symbol="DockLeft" />
                </ui:FANavigationViewItem.IconSource>
            </ui:FANavigationViewItem>
        </ui:FANavigationView.MenuItems>
        <ui:FANavigationView.FooterMenuItems>
            <ui:FANavigationViewItem Content="Settings" Tag="settings" AutomationProperties.Name="Settings">
                <ui:FANavigationViewItem.IconSource>
                    <ui:FASymbolIconSource Symbol="Settings" />
                </ui:FANavigationViewItem.IconSource>
            </ui:FANavigationViewItem>
        </ui:FANavigationView.FooterMenuItems>

        <DockPanel>
            <!-- One line on every page while the engine is not running: the
                 schedule, snapping and repair after a hot-plug all need it. -->
            <Border Name="EngineBanner" DockPanel.Dock="Top" Classes="notice" Margin="16,12,16,0" Padding="12,8"
                    IsVisible="False">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <ui:FASymbolIcon Symbol="Important" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center"
                               Text="The engine is not running, so nothing follows the night light schedule or snaps windows." />
                    <Button Grid.Column="2" Content="How to start it" Click="OnEngineHelp" Margin="12,0,0,0"
                            VerticalAlignment="Center" AutomationProperties.Name="How to start the engine" />
                </Grid>
            </Border>
            <ContentControl Name="PageHost" />
        </DockPanel>
    </ui:FANavigationView>
</Window>
