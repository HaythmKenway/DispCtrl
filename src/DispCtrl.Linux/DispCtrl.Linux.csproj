<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Linux command line and, as "engine", the resident process. It
       references no Windows project: its build settings are
       build/linux/Linux.Build.props, and docs/LINUX.md has the rest. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>dispctrl-linux</AssemblyName>
    <RootNamespace>DispCtrl.Linux</RootNamespace>
    <Description>Per-display brightness, dimming, night light, arrangement and presets on Linux.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DispCtrl.Linux.Core\DispCtrl.Linux.Core.csproj" />
  </ItemGroup>

</Project>
